# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=file:./storage/data.sqlite

# Storage
STORAGE_DIR=./storage

# Project Defaults
PROJECT_DEFAULT_KEY=dev-project

# VCS Integration
# Fine-grained GitHub PAT with `contents:write` and `pull_requests:write` scopes.
GITHUB_TOKEN=
GITLAB_TOKEN=
# Optional: self-hosted GitLab API base (default: https://gitlab.com/api/v4)
# GITLAB_API_URL=https://gitlab.com/api/v4

# LLM Provider Configuration
# Options: gapgpt | deepinfra | together | togetherai | mock
LLM_PROVIDER=gapgpt
LLM_API_KEY=
# GapGPT model (default: gapgpt-qwen-3.6)
LLM_MODEL=gapgpt-qwen-3.6
# Optional override - default for gapgpt: https://api.gapgpt.app/v1
# LLM_BASE_URL=https://api.gapgpt.app/v1

# CI Monitor
MAX_PR_ATTEMPTS=3
CI_POLL_INTERVAL_MS=60000

# Security / Hardening
# Require X-Project-Key header matching body projectKey
INGESTION_AUTH_ENABLED=false
# Rate limit: max requests per IP per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# Server-side error sampling (0.0 - 1.0)
SERVER_SAMPLE_RATE=1.0
# Redact URL query params and tokens in stack traces
REDACT_URLS=true
REDACT_QUERY_PARAMS=true

# Logging
LOG_LEVEL=info
